# NextAuth v5 — secret dùng ký JWT session, tạo secret RIÊNG cho từng môi trường (không dùng chung dev/production).
# Tạo bằng: npx auth secret   (hoặc: openssl rand -base64 32)
AUTH_SECRET=

# BẮT BUỘC trên production (không cần ở dev, localhost tự suy ra được) — domain đầy đủ có https://, không có
# dấu / cuối. Thiếu biến này thì next-auth/react (signIn/signOut ở client) sẽ dùng nhầm giá trị mặc định
# http://localhost:3000 baked vào bundle lúc build, khiến bấm "Đăng xuất" bị đưa về localhost thay vì domain
# thật. Đặt CẢ 2 biến giống hệt nhau (NextAuth v5 đọc AUTH_URL phía server, nhưng bundle client vẫn đọc tên cũ
# NEXTAUTH_URL) — sau khi đổi domain/thêm biến này PHẢI build lại (npm run build) vì nó được inline lúc build,
# sửa .env rồi restart pm2 suông không đủ.
AUTH_URL=https://your-domain.com
NEXTAUTH_URL=https://your-domain.com

# Supabase Postgres — transaction pooler (port 6543), dùng cho app lúc chạy (nhiều connection ngắn hạn, phù hợp serverless).
DATABASE_URL=

# Supabase Postgres — direct connection (port 5432), CHỈ dùng cho migrate/db push/seed (không dùng lúc app chạy production).
DIRECT_URL=
