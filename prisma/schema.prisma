generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  KY_THUAT
  CAY_MO
  KHO_MO
  KHO_THANH_PHAM
  SALE
  MOI_TRUONG
  DIEU_PHOI
}

enum WarehouseType {
  SAN_XUAT
  THANH_PHAM
}

// Luồng kiểm tra gắn theo NV cấy mô — do NV kho mô cài đặt (xem User.inspectionLane), dùng để phân
// loại NV cấy mô theo mức độ cần kiểm tra khi kho mô xử lý/nhận bàn giao.
enum InspectionLane {
  XANH
  DO
}

enum RoomType {
  // Kho sản xuất — "Kho sáng" gồm 2 phòng: mẫu mẹ (kệ gắn mã cây + nhân viên) và ra rễ (không ràng buộc)
  PHONG_MAU_ME
  PHONG_RA_RE
  // Phòng tối cá nhân của 1 NV cấy mô cụ thể — 1 Room/NV (assignedStaffId), không quản lý theo giàn kệ,
  // tự động sinh khi NV cấy mô được gán địa điểm làm việc (xem PATCH /api/users/[id], lib/dark-room.ts).
  PHONG_TOI
  // Phòng nhiễm — 1 phòng/kho sản xuất, không quản lý theo giàn kệ. Chưa gắn logic nghiệp vụ (placeholder).
  PHONG_NHIEM
  // Kho thành phẩm
  PHONG_DAT_TIEU_CHUAN
  PHONG_THEO_DOI
  PHONG_HAN_TUI
  PHONG_THI_TRUONG
}

enum PlantStage {
  MAU_ME
  THANH_PHAM
}

enum LotStatus {
  ACTIVE
  TRANSFERRED
  CONTAMINATED
  DESTROYED
  PLANTED
  SOLD
  // Lô "ảo" đại diện hàng dự kiến từ 1 Kế hoạch nhập kho (GoodsReceipt.status = PLANNED) — chưa có
  // hàng thật, không xuất hiện ở các trang tồn kho ACTIVE (mọi query hiện có đều lọc status: ACTIVE sẵn).
  // Chuyển thành ACTIVE khi Kho thành phẩm xác nhận số liệu thật (xem PATCH /api/goods-receipts/[id]/confirm).
  PLANNED
}

enum InstructionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  ENDED // Kết thúc — tự động chuyển khi hết thời gian (qua Chủ nhật tuần chỉ định) hoặc dùng hết mẫu mẹ
}

// Lý do 1 chỉ định chuyển sang ENDED — TIME_UP và EARLY_END_BY_STAFF đều có thể còn "MM dư" để bàn giao
// (MOTHER_USED_UP nghĩa là dùng hết mẫu mẹ được cấp, không còn dư).
enum InstructionEndReason {
  TIME_UP
  MOTHER_USED_UP
  // NV cấy mô tự bấm "Kết thúc chỉ định sớm" ở trang Nhập dữ liệu cấy (VD nghỉ đột xuất giữa tuần,
  // không làm nốt các ngày còn lại) — xem PATCH /api/instructions/[id] nhánh endEarly.
  EARLY_END_BY_STAFF
}

// Phân loại các kệ "chung" (chưa gán NV, assignedStaffId null) trong Phòng mẫu mẹ — dùng để tách nơi
// nhận hàng dư sản xuất hàng ngày (Kho đúng hạn) khỏi nơi nhận MM dư khi chỉ định kết thúc do hết thời
// gian (Kho quá hạn). Không áp dụng cho kệ "đã chia" (luôn null).
enum SharedMotherPool {
  QUA_HAN
  DUNG_HAN
}

// Phân loại Nhóm giàn kệ (ShelfGroup) dùng cho cơ chế xoay vòng — RA_RE = "Nhóm tuần ra rễ" (Phòng ra
// rễ), MAU_ME = "Nhóm tuần mẫu mẹ" (kệ đã chia trong Phòng mẫu mẹ). Nhóm không gắn rotationKind vẫn dùng
// bình thường cho mục đích gộp kệ tự do (groupId), không tham gia xoay vòng.
enum ShelfGroupRotationKind {
  RA_RE
  MAU_ME
}

enum TransferStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum OrderStatus {
  DRAFT
  HELD
  CONFIRMED
  SHIPPED
  CANCELLED
}

// Thị trường xuất hàng của đơn — nhãn hiển thị tiếng Việt xem MARKET_LABELS trong src/types/index.ts.
enum OrderMarket {
  NOI_DIA
  DONG_NAM_A
  EU
  US
  AUS
  NHAT
  HAN_QUOC
}

enum AlertType {
  CONTAMINATION_HIGH
  OUTPUT_DEVIATION
  // Kho thành phẩm "Hoàn thành xử lý" 1 Yêu cầu xử lý đơn hàng nhưng số lượng thực tế thu được
  // (actualOutputQuantity) thấp hơn số thực cần (neededQuantity) — báo cho đúng Sale sở hữu đơn đó
  // (userId) biết đơn có thể thiếu hàng, khác OUTPUT_DEVIATION (chỉ dành riêng cho KY_THUAT/lệch tiến độ
  // cấy, có luồng chọn nguyên nhân xử lý riêng — không dùng chung để tránh lẫn 2 luồng).
  ORDER_PROCESSING_SHORTFALL
  ORDER_EXPIRING
  ORDER_EXPIRED
  STOCK_LOW
  LOT_READY_TRANSFER
  ORDER_PENDING_PACK
  MEDIUM_HANDOVER_READY
  MOTHER_LOT_READY
  // Lô thành phẩm đang ở Phòng ra rễ đã đủ số tuần ra rễ riêng của mã cây (PlantType.rootingWeeks) — báo
  // cho KHO_MO biết đến hạn tạo phiếu bàn giao sang Kho thành phẩm (xem src/lib/rooting-ready.ts).
  ROOTING_LOT_READY
  MEDIUM_ORDER_CREATED
  CONTAMINATION_PROPOSAL
  // Kho mô vừa kiểm tra xong 1 phiếu bàn giao Phòng tối của NV luồng Đỏ/chưa cài đặt luồng — báo cho
  // đúng NV cấy mô đó (userId) biết số lượng được ghi nhận (xem TransferInspectionItem.creditedQuantity).
  INSPECTION_RESULT_READY
  // NV bị khóa tài khoản do đăng nhập sai mật khẩu quá 5 lần liên tiếp (xem User.lockedAt) — báo cho
  // SUPER_ADMIN (targetRole) để mở khóa lại.
  ACCOUNT_LOCKED
  // NV bấm "Quên mật khẩu" ở trang đăng nhập — báo cho SUPER_ADMIN (targetRole) tự cấp lại mật khẩu
  // thủ công, báo riêng ngoài hệ thống (không gửi email/SMS tự động).
  PASSWORD_RESET_REQUESTED
  // Tỉ lệ nhiễm mẫu mẹ sau ủ sáng (tổng mẫu mẹ nhiễm cộng dồn / tổng mẫu mẹ được cấp cho chỉ định)
  // vượt ngưỡng Admin cấp cao cài đặt (mother_contamination_alert_pct) — kiểm tra lại ngay khi NV cấy mô
  // lưu nhật ký hàng ngày (xem POST /api/daily-records), báo cho KHO_MO (targetRole) biết sớm trước khi
  // nhận bàn giao thật.
  MOTHER_CONTAMINATION_HIGH
  // Phiếu nhập hàng từ nhà cung cấp cho phép trả hàng (Supplier.allowsReturn) — báo Kho thành phẩm
  // (targetRole) cần kiểm tra lại trước hạn (receipt.createdAt + supplier.returnWindowDays ngày) để
  // phát hiện thêm cây không đạt phát sinh sau nhận hàng (xem GoodsReceiptItem, trang /goods-receipts).
  GOODS_RECEIPT_RETURN_DUE
  // NV cấy mô đăng ký hoàn thành sớm chỉ định hoặc đăng ký làm thêm ngoài giờ (xem ExtraWorkRequest) —
  // báo cho KHO_MO (targetRole) cùng kho sản xuất biết để xác nhận/duyệt.
  EXTRA_WORK_REQUEST
  // Kho mô bấm "Từ chối" 1 đăng ký hoàn thành sớm/làm thêm ngoài giờ — báo cho đúng NV cấy mô đã gửi
  // đăng ký đó (userId) biết lý do đăng ký không được duyệt. Xem PATCH /api/extra-work-requests/[id].
  EXTRA_WORK_REQUEST_REJECTED
  // NV cấy mô bấm "Số lượng không đủ" khi nhận bàn giao Chỉ định cấy xử lý — số cây thực tế thấy trên kệ
  // không khớp inputQuantity của chỉ định. Báo cho đúng Kho mô đã gán chỉ định đó (userId) biết để kiểm
  // tra lại kệ trước khi gán lại — xem RepackInstruction.quantityIssueReportedAt.
  REPACK_QUANTITY_MISMATCH
}

// Đề xuất Kho mô gửi Admin xử lý số lượng đang nằm ở Phòng nhiễm — Trồng lại hoặc Hủy bỏ.
enum ContaminationProposalType {
  TRONG
  HUY
}

enum ContaminationProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AlertStatus {
  UNREAD
  READ
  RESOLVED
}

// Nguyên nhân KY_THUAT chọn khi xử lý alert OUTPUT_DEVIATION — chỉ áp dụng cho loại alert này.
enum DeviationCause {
  KY_THUAT_SAI // Do nhân viên kỹ thuật ra chỉ định sai
  CAY_MO_SAI   // Do nhân viên cấy sai
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// USERS
// ============================================================

model User {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  email     String     @unique
  password  String
  avatar    String?    @db.Text
  role      UserRole?
  status    UserStatus @default(PENDING)
  isActive  Boolean    @default(true)
  holdDays  Int?
  // Đếm số lần đăng nhập sai mật khẩu liên tiếp — reset về 0 khi đăng nhập đúng hoặc khi SUPER_ADMIN
  // mở khóa. Đạt 5 lần thì khóa tài khoản (xem lockedAt).
  failedLoginAttempts Int @default(0)
  // Khác null = tài khoản đang bị khóa do đăng nhập sai quá 5 lần — chặn đăng nhập dù đúng mật khẩu.
  // Chỉ SUPER_ADMIN mở khóa lại được (PATCH /api/users/[id] { unlockAccount: true }).
  lockedAt DateTime?
  // ID phiên đăng nhập ĐANG hoạt động — mỗi lần đăng nhập thành công (authorize() ở src/lib/auth.ts) ghi
  // đè bằng 1 giá trị random mới, tự động vô hiệu phiên cũ (đăng nhập ở thiết bị/trình duyệt khác thì
  // JWT của thiết bị trước đó không còn khớp field này nữa — chỉ CHO PHÉP 1 phiên hoạt động/tài khoản).
  // null = chưa từng đăng nhập lần nào (tài khoản mới tạo).
  currentSessionId String?
  // Địa điểm làm việc — áp dụng cho KHO_MO/CAY_MO/MOI_TRUONG (ràng buộc 1 kho sản xuất/SAN_XUAT) và
  // SALE (ràng buộc 1 kho thành phẩm/THANH_PHAM — xem tồn Phòng đạt tiêu chuẩn ở đó, xem thêm RoomAccess cho
  // các Phòng thị trường được cấp quyền riêng). KHO_THANH_PHAM cũng gán được 1 kho THÀNH PHẨM nhưng
  // CHỈ mang tính hiển thị/lưu trữ — không giới hạn phạm vi thao tác (xem getFinishedQualifiedRooms ở
  // src/lib/processing.ts). NV kỹ thuật (KY_THUAT) không cần gán, luôn làm việc ở mọi kho. Chỉ
  // SUPER_ADMIN được sửa field này.
  workplaceWarehouseId String?
  workplaceWarehouse    Warehouse? @relation(fields: [workplaceWarehouseId], references: [id])
  // Luồng kiểm tra — chỉ áp dụng cho NV cấy mô (CAY_MO), do NV kho mô phụ trách cùng kho sản xuất cài
  // đặt (xem /api/users/[id] PATCH). Null = chưa cài đặt.
  inspectionLane InspectionLane?
  // Năng lực cấy — chỉ áp dụng cho NV cấy mô (CAY_MO): số cụm mẫu mẹ NV đó dùng hết trong 1 tuần
  // (thể hiện tốc độ cấy), chỉ ADMIN/SUPER_ADMIN cài đặt được (xem /api/users/[id] PATCH).
  plantingCapacity Int @default(1920)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  plantingInstructions PlantingInstruction[] @relation("CreatedBy")
  assignedInstructions PlantingInstruction[] @relation("AssignedTo")
  handedOverInstructions PlantingInstruction[] @relation("HandedOverBy")
  contaminationProposalsRequested ContaminationProposal[] @relation("ContaminationProposalRequestedBy")
  contaminationProposalsApproved  ContaminationProposal[] @relation("ContaminationProposalApprovedBy")
  contaminationRoomEntries        ContaminationRoomEntry[]
  dailyRecords         DailyRecord[]
  transfersFrom        Transfer[]            @relation("TransferFrom")
  transfersTo          Transfer[]            @relation("TransferTo")
  orders               Order[]
  alerts               Alert[]
  roomAccess           RoomAccess[]
  assignedShelves      Shelf[]                @relation("ShelfAssignedStaff")
  assignedRooms        Room[]                 @relation("RoomAssignedStaff")
  mediumOrdersConfirmed    MediumOrder[]      @relation("MediumOrderConfirmedBy")
  mediumOrderDaysConfirmed MediumOrderDay[]   @relation("MediumOrderDayConfirmedBy")
  checklistItems       ChecklistItem[]
  lotInspections       LotInspection[]
  inspectedLots        Lot[]                 @relation("LotInspectedBy")
  transferInspectionsPerformed TransferInspection[] @relation("TransferInspectedBy")
  materialIntakes      MaterialIntake[]
  processingTickets    ProcessingTicket[]
  orderProcessingRequestsCompleted OrderProcessingRequest[]
  goodsReceipts        GoodsReceipt[] @relation("GoodsReceiptCreatedBy")
  goodsReceiptsConfirmed GoodsReceipt[] @relation("GoodsReceiptConfirmedBy")
  goodsReceiptItemsReturned GoodsReceiptItem[] @relation("GoodsReceiptItemReturnedBy")
  extraWorkRequests         ExtraWorkRequest[] @relation("ExtraWorkRequestStaff")
  extraWorkRequestsResponded ExtraWorkRequest[] @relation("ExtraWorkRequestRespondedBy")
  productPrices             ProductPrice[]
  repackCreated             RepackInstruction[] @relation("RepackCreatedBy")
  repackAssignedTo          RepackInstruction[] @relation("RepackAssignedTo")
  repackAssignedBy          RepackInstruction[] @relation("RepackAssignedBy")
  repackInspectedBy         RepackInstruction[] @relation("RepackInspectedBy")
  repackPlacedBy            RepackInstruction[] @relation("RepackPlacedBy")
  repackQuantityIssueReportedBy RepackInstruction[] @relation("RepackQuantityIssueReportedBy")

  @@map("users")
}

// Bật/tắt quyền truy cập từng trang (href) cho từng vai trò — quản lý qua UI Admin.
model RolePermission {
  id        String   @id @default(cuid())
  role      UserRole
  href      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, href])
  @@map("role_permissions")
}

// ============================================================
// SYSTEM CONFIG
// ============================================================

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

// ============================================================
// CHECKLIST — đầu việc hàng ngày theo vai trò
// ============================================================

// Danh mục đầu việc Admin soạn sẵn cho từng vai trò — mỗi ngày hệ thống tự sinh 1 ChecklistItem
// cho từng NV thuộc vai trò đó từ các template đang isActive.
model ChecklistTemplate {
  id        String   @id @default(cuid())
  role      UserRole
  title     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ChecklistItem[]

  @@map("checklist_templates")
}

// 1 dòng = 1 đầu việc đã giao cho 1 NV vào 1 ngày cụ thể (assignedDate). title chép lại từ template lúc
// sinh (không đổi ngược nếu sau này Admin sửa template). Việc chưa hoàn thành sẽ tiếp tục hiện ở checklist
// "hôm nay" của NV cho tới khi tích xong — không sinh thêm dòng mới cho cùng template khi còn dòng cũ
// đang PENDING, nên xem như tự động "dồn sang ngày hôm sau" mà không nhân bản.
model ChecklistItem {
  id           String            @id @default(cuid())
  templateId   String
  template     ChecklistTemplate @relation(fields: [templateId], references: [id])
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  title        String
  assignedDate DateTime // chỉ lấy phần ngày (00:00) — ngày đầu việc được sinh ra, dùng để thống kê theo ngày
  completed    Boolean           @default(false)
  completedAt  DateTime?
  createdAt    DateTime          @default(now())

  logs ChecklistItemLog[]

  @@map("checklist_items")
}

// Lịch sử mỗi lần đổi trạng thái hoàn thành của 1 ChecklistItem — ghi lại vĩnh viễn, không sửa/xoá,
// để báo cáo cũ không bị viết lại khi NV tick/bỏ tick sau này. completed = trạng thái SAU khi đổi.
model ChecklistItemLog {
  id        String        @id @default(cuid())
  itemId    String
  item      ChecklistItem @relation(fields: [itemId], references: [id])
  completed Boolean
  changedAt DateTime      @default(now())

  @@map("checklist_item_logs")
}

// Ngưỡng % hoàn thành tối thiểu/ngày theo từng vai trò — Admin cấu hình, dùng để tô cảnh báo trên báo cáo.
model ChecklistThreshold {
  role       UserRole @id
  minPercent Int      @default(80)
  updatedAt  DateTime @updatedAt

  @@map("checklist_thresholds")
}

// ============================================================
// PLANT TYPES
// ============================================================

// Loại cây (nhóm chung) — mã 2 ký tự, VD: MT, AL, PD. Mỗi loại cây có nhiều "chi tiết loại cây"
// (PlantType) đánh số 001-999 bên trong.
model PlantCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plantTypes PlantType[]

  @@map("plant_categories")
}

// Chi tiết loại cây (giống cây cụ thể) — mã đầy đủ = mã Loại cây (category.code) + số thứ tự 3 chữ số
// (seq, 001-999) trong danh mục đó, VD: "MT001". Đây là entity thực sự được dùng xuyên suốt hệ thống
// (Lot, Shelf, PlantingInstruction) — "Loại cây" (PlantCategory) chỉ là nhóm cha để phân loại và sinh
// mã tự động. Tỉ lệ nhân mẫu mẹ/ra rễ + môi trường KHÔNG có cấu hình mặc định ở đây — KY_THUAT tự nhập
// theo tình trạng thực tế của từng lô khi tạo chỉ định cấy (xem PlantingInstructionItem).
model PlantType {
  id                 String   @id @default(cuid())
  categoryId         String
  category           PlantCategory @relation(fields: [categoryId], references: [id])
  seq                Int // số thứ tự để sắp hiển thị trong Loại cây, không quyết định code
  code               String   @unique // category.code (2 ký tự, tự lấy theo Loại cây) + 3 ký tự NV nhập tay, VD: "MT001"
  name               String
  description        String?
  // Số tuần cố định (không phải khoảng min-max) do Admin cài đặt cho từng chi tiết loại cây.
  // Mặc định: 4 tuần cho mọi Loại cây, riêng MT (Monstera) là 6 tuần.
  transferWaitWeeks  Int      @default(4) // Thời gian đợi cấy chuyển (mẫu mẹ) — dùng tính Lot.expectedMoveAt khi stage = MAU_ME
  // Mặc định 3 tuần cho MỌI loại cây.
  rootingWeeks       Int      @default(3) // Thời gian ra rễ (thành phẩm) — dùng tính Lot.expectedMoveAt khi stage = THANH_PHAM
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Nhóm biến thể (đột biến) — 1 mã cây chỉ thuộc ĐÚNG 1 nhóm (VD MT047 thuộc nhóm {MT047, MT005,
  // MT042}). Có nhóm (khác null) VÀ nhóm có >1 thành viên thì chỉ định cấy dùng mã cây này mới hiện
  // được checkbox "Phát sinh cây cần phân loại" lúc nhập dữ liệu cấy — xem POST /api/daily-records.
  variantGroupId     String?
  variantGroup       PlantVariantGroup? @relation(fields: [variantGroupId], references: [id])

  lots                 Lot[]
  plantingInstructions PlantingInstruction[]
  shelves              Shelf[]
  contaminationProposals ContaminationProposal[]
  processingTickets    ProcessingTicket[]
  orderProcessingRequests OrderProcessingRequest[]
  goodsReceiptItems    GoodsReceiptItem[]
  repackInstructions   RepackInstruction[]

  @@unique([categoryId, seq])
  @@map("plant_types")
}

// Nhóm các mã cây có thể "lẫn" nhau khi cấy ra thực tế (đột biến) — VD cấy mẫu mẹ MT047 nhưng cây/cụm
// tạo ra có thể là MT047 (đúng chỉ định), MT005 hoặc MT042. Admin quản lý tại /plant-types. Khi NV cấy
// mô tích "Phát sinh cây cần phân loại" lúc nhập dữ liệu, được chọn nhập số lượng riêng cho từng mã
// trong nhóm (thay vì gộp chung vào đúng 1 mã của chỉ định như mặc định).
model PlantVariantGroup {
  id        String      @id @default(cuid())
  name      String
  members   PlantType[]
  createdAt DateTime    @default(now())

  @@map("plant_variant_groups")
}

// ============================================================
// MEDIUM TYPES
// ============================================================

model MediumType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  instructionItemsAsMotherMedium    PlantingInstructionItem[] @relation("ItemMotherMedium")
  instructionItemsAsFinishedMedium  PlantingInstructionItem[] @relation("ItemFinishedMedium")
  orderItems                        MediumOrderItem[]

  @@map("medium_types")
}

// ============================================================
// MATERIALS (vật tư) — mã vật tư do Admin cấp cao (SUPER_ADMIN) tạo, NV môi trường xem tồn + nhập vật tư.
// ============================================================

model Material {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  unit      String?
  quantity  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intakes MaterialIntake[]

  @@map("materials")
}

// 1 lần NV môi trường nhập vật tư về kho — cộng dồn vào Material.quantity, giữ lịch sử để đối chiếu.
model MaterialIntake {
  id          String   @id @default(cuid())
  materialId  String
  material    Material @relation(fields: [materialId], references: [id])
  quantity    Int
  notes       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("material_intakes")
}

// ============================================================
// SUPPLIERS (nhà cung cấp) — mã/tên do Admin cấp cao (SUPER_ADMIN) tạo, Kho thành phẩm chọn khi nhập
// hàng ngoài (GoodsReceipt).
// ============================================================

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  // Nhà cung cấp có cho phép trả hàng hay không — nếu có, Kho thành phẩm phải "kiểm tra" lại trong vòng
  // returnWindowDays ngày kể từ ngày nhập (GoodsReceipt.createdAt) để phát hiện thêm cây không đạt phát
  // sinh sau khi nhận hàng (xem GoodsReceiptItem). returnWindowDays chỉ có ý nghĩa khi allowsReturn = true.
  allowsReturn     Boolean @default(false)
  returnWindowDays Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goodsReceipts GoodsReceipt[]

  @@map("suppliers")
}

// ============================================================
// PRODUCT PRICE LIST (bảng giá sản phẩm) — mã/tên do Admin cấp cao (SUPER_ADMIN) tạo, khớp đúng "Item
// code" trên invoice xuất khẩu (VD "PD19T10"). Admin cấp cao cập nhật giá mỗi tháng (ProductPrice mới,
// giữ lại lịch sử các tháng trước). NV Sale dùng để đối chiếu invoice PDF khách gửi (xem
// /api/price-check) — "giá đang áp dụng" = ProductPrice có effectiveMonth gần nhất không sau tháng hiện
// tại (KHÔNG theo ngày trên invoice).
// ============================================================

model Product {
  id            String   @id @default(cuid())
  code          String   @unique // Item code trên invoice, VD "PD19T10"
  name          String // Model name
  botanicalName String?
  unit          String? // VD "Plant/UNY"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prices ProductPrice[]

  @@map("products")
}

// 1 dòng = giá áp dụng cho 1 sản phẩm kể từ đầu 1 tháng cụ thể (effectiveMonth luôn là ngày 1 đầu
// tháng). "Giá đang áp dụng" tại thời điểm bất kỳ = dòng có effectiveMonth lớn nhất <= tháng đó.
model ProductPrice {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price          Float // USD
  effectiveMonth DateTime
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@unique([productId, effectiveMonth])
  @@map("product_prices")
}

enum GoodsReceiptStatus {
  // Kế hoạch nhập kho — chưa có hàng thật, chỉ ước tính (xem GoodsReceiptItem.plannedLotId). Không cộng
  // gì vào tồn thực tế/tồn đạt tiêu chuẩn cho tới khi CONFIRMED.
  PLANNED
  // Đã có hàng thật — hành vi immediate-effect như trước khi có PLANNED (mặc định cho phiếu tạo theo
  // luồng "Đã có hàng thật" cũ, và cho phiếu PLANNED sau khi Kho thành phẩm xác nhận số liệu).
  CONFIRMED
  // Kế hoạch bị huỷ (hàng không về) — chỉ áp dụng được khi đang PLANNED và chưa có đơn nào giữ chỗ dựa
  // vào lô ảo của kế hoạch này (xem PATCH /api/goods-receipts/[id]/confirm action=cancel).
  CANCELLED
}

// 1 lần Kho thành phẩm nhận hàng từ nhà cung cấp ngoài — khác Transfer (nội bộ giữa các phòng/kho).
// roomId = Phòng đạt tiêu chuẩn nhận hàng; phần "đạt" cộng thẳng vào đó (tồn thực tế + tồn đạt tiêu chuẩn đều tăng),
// phần "không đạt" cộng vào Phòng theo dõi CÙNG kho (tồn thực tế tăng vì trang tồn thực tế cộng gộp mọi
// phòng, nhưng tồn đạt tiêu chuẩn KHÔNG tăng vì trang tồn đạt tiêu chuẩn chỉ đọc Phòng đạt tiêu chuẩn — xem
// POST /api/goods-receipts). status mặc định CONFIRMED (hành vi cũ, immediate-effect) — chỉ khác khi tạo
// dưới dạng "Kế hoạch nhập kho" (status PLANNED, xem GoodsReceiptItem.plannedLotId).
model GoodsReceipt {
  id          String   @id @default(cuid())
  code        String   @unique
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  createdById String
  createdBy   User     @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id])
  notes       String?
  createdAt   DateTime @default(now())

  status        GoodsReceiptStatus @default(CONFIRMED)
  // Chỉ có giá trị khi status = PLANNED — ngày dự kiến hàng thật về, dùng tính khả dụng tương lai cho đơn
  // hàng (xem Lot.expectedDate, src/lib/order-availability.ts).
  expectedDate  DateTime?
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?    @relation("GoodsReceiptConfirmedBy", fields: [confirmedById], references: [id])

  items GoodsReceiptItem[]

  @@map("goods_receipts")
}

// 1 dòng = 1 loại cây trong phiếu nhập hàng. quantityPassed = quantityDelivered - quantityRejected,
// tính sẵn lúc tạo và lưu lại để giữ lịch sử đúng ngay cả khi sau này đổi cách tính. Với dòng thuộc phiếu
// PLANNED, 3 số lượng này ban đầu chỉ là ƯỚC TÍNH (quantityDelivered = quantityPassed = estimate,
// quantityRejected = 0) và bị GHI ĐÈ bằng số liệu thật lúc xác nhận (không giữ riêng 2 bộ số — kế hoạch
// coi như chưa từng "đạt/không đạt" gì cho tới khi hàng về thật).
model GoodsReceiptItem {
  id                String       @id @default(cuid())
  receiptId         String
  receipt           GoodsReceipt @relation(fields: [receiptId], references: [id])
  plantTypeId       String
  plantType         PlantType    @relation(fields: [plantTypeId], references: [id])
  // Quy cách thành phẩm nhận (T01/T05/T10) — quyết định lô "đạt"/"không đạt" của dòng này cộng vào đâu.
  // Dữ liệu cũ trước khi có field này luôn ngầm định T01 (hành vi hard-code trước đây).
  stageCode         String       @default("T01")
  quantityDelivered Int
  quantityRejected  Int
  quantityPassed    Int

  // Chỉ có giá trị khi receipt.status = PLANNED (hoặc từng là PLANNED) — liên kết 1-1 tới lô "ảo"
  // (Lot.status = PLANNED) mà dòng kế hoạch này tạo ra, để lúc xác nhận biết chính xác cần điều chỉnh lô
  // nào (không gộp theo phòng/quy cách như luồng nhập hàng thật, vì nhiều kế hoạch cùng phòng/quy cách
  // phải tách biệt cho tới khi confirm — xem PATCH /api/goods-receipts/[id]/confirm).
  plannedLotId String? @unique
  plannedLot   Lot?    @relation(fields: [plannedLotId], references: [id])

  // Trả hàng (chỉ áp dụng khi Supplier.allowsReturn) — Kho thành phẩm "kiểm tra" trong vòng
  // Supplier.returnWindowDays ngày kể từ receipt.createdAt, phát hiện thêm cây không đạt trong số đã
  // tính "đạt" lúc nhập, trả lại nhà cung cấp: trừ thẳng khỏi lô đã cộng ở Phòng đạt tiêu chuẩn (giảm cả tồn
  // thực tế lẫn tồn đạt tiêu chuẩn vì hàng rời khỏi kho thật — khác phần "không đạt" ban đầu vẫn nằm nguyên
  // trong Phòng theo dõi). returnedAt khác null nghĩa là đã kiểm tra xong (kể cả khi returnQuantity = 0
  // — kiểm tra không phát hiện thêm lỗi vẫn tính là đã xử lý xong).
  returnQuantity Int?
  returnedAt     DateTime?
  returnedById   String?
  returnedBy     User?     @relation("GoodsReceiptItemReturnedBy", fields: [returnedById], references: [id])

  @@map("goods_receipt_items")
}

// ============================================================
// WAREHOUSES
// ============================================================

model Warehouse {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  type        WarehouseType
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  rooms        Room[]
  shelves      Shelf[]
  transfersIn  Transfer[] @relation("TransferTo")
  transfersOut Transfer[] @relation("TransferFrom")
  staff        User[]
  contaminationProposals ContaminationProposal[]

  @@map("warehouses")
}

// ============================================================
// ROOMS — cả kho sản xuất (phòng sáng/phòng tối) và kho thành phẩm
// (phòng đạt tiêu chuẩn/theo dõi/hàn túi/thị trường) đều dùng model này.
// ============================================================

model Room {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        RoomType
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Chỉ có giá trị với Room type = PHONG_TOI (phòng tối cá nhân) — 1 NV cấy mô = 1 Room riêng, đóng
  // vai trò tương đương assignedStaffId trên Shelf ở Phòng mẫu mẹ nhưng ở cấp Room (không qua kệ).
  assignedStaffId String?
  assignedStaff   User?    @relation("RoomAssignedStaff", fields: [assignedStaffId], references: [id])

  shelves           Shelf[]
  lots              Lot[]      @relation("LotDirectRoom")
  transfersFromRoom Transfer[] @relation("TransferFromRoom")
  transfersToRoom   Transfer[] @relation("TransferToRoom")
  roomAccess        RoomAccess[]
  processingTickets ProcessingTicket[]
  orderProcessingRequests OrderProcessingRequest[]
  orderProcessingRequestsAsTarget OrderProcessingRequest[] @relation("OrderProcessingRequestTarget")
  goodsReceipts     GoodsReceipt[]

  @@map("rooms")
}

// Cấp quyền xem 1 phòng cho 1 user cụ thể — dùng cho Phòng thị trường (SALE).
model RoomAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roomId])
  @@map("room_access")
}

// ============================================================
// SHELVES
// ============================================================

model Shelf {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  // Luôn trỏ tới kho chứa kệ này (kể cả khi kệ nằm trong 1 room) — giữ để
  // các query/hiển thị hiện có dựa vào shelf.warehouse tiếp tục hoạt động.
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  // Có giá trị khi kệ nằm trong 1 phòng cụ thể (mọi kệ hiện nay đều vậy).
  // Để null nếu sau này có kệ gắn thẳng vào kho, không qua phòng nào.
  roomId      String?
  room        Room?     @relation(fields: [roomId], references: [id])
  rowNumber   Int?
  colNumber   Int?
  // Khối vật lý trong 1 phòng — các kệ cùng 1 hàng (rowNumber), VD R04C01 đến R04C99 trong CÙNG 1 phòng,
  // thuộc chung 1 block (VD "R04"). Không gộp xuyên phòng (Phòng mẫu mẹ và Phòng ra rễ luôn tách block
  // riêng dù trùng rowNumber) — chỉ là nhãn tiện nhóm/lọc, tính từ rowNumber lúc tạo/đổi mã kệ.
  block       String?
  // Nhóm gộp các kệ lẻ lại (VD kệ A1C10 + B1C09 cùng 1 Nhóm dù khác block) — không bắt buộc, chỉ Admin
  // cấp cao (SUPER_ADMIN) mới cài đặt được (xem /settings/shelf-groups). Chọn theo từng kệ, không theo
  // block — có thể gộp kệ từ nhiều block/phòng/kho khác nhau vào cùng 1 Nhóm.
  groupId     String?
  group       ShelfGroup? @relation("ShelfPhysicalGroup", fields: [groupId], references: [id], onDelete: SetNull)
  // Nhóm xoay vòng (ShelfGroup có rotationKind = RA_RE hoặc MAU_ME) — SUPER_ADMIN gán kệ vào đúng 1
  // trong các Nhóm đã tạo ở /settings/shelf-groups (xem "Quản lý kệ" ở đó), TÁCH BIỆT với groupId ở trên
  // (1 kệ có thể vừa thuộc 1 Nhóm vật lý tự do vừa thuộc 1 Nhóm xoay vòng cùng lúc). Cây ra rễ/mẫu mẹ đưa
  // vào kho tuần nào thì tự xếp vào đúng kệ thuộc Nhóm có rotationOrder = tuần đó (xem getCurrentWeekSlot
  // trong src/lib/rooting-week-group.ts — công thức tuần liên tục mod N, N = tổng số Nhóm cùng
  // rotationKind, không cần lưu "nhóm đang active"). rotationGroupId chỉ quyết định XẾP KỆ NÀO (dùng chung
  // 1 lịch xoay vòng cho mọi mã cây trong kho) — KHÔNG dùng để tính "đến hạn chuyển kho thành phẩm"; hạn đó
  // tính riêng theo Lot.expectedMoveAt (đã cộng đúng PlantType.rootingWeeks của từng lô lúc tạo — xem
  // src/lib/rooting-ready.ts). Nhóm tuần mẫu mẹ tương tự dùng transferWaitWeeks riêng của từng mã cây —
  // xem src/lib/mother-week-group.ts.
  rotationGroupId String?
  rotationGroup   ShelfGroup? @relation("ShelfRotationGroup", fields: [rotationGroupId], references: [id], onDelete: SetNull)
  // Tối đa được xếp trên kệ này — tính theo TÚI cho cả Phòng mẫu mẹ (mặc định 600 nếu không nhập) lẫn
  // Phòng ra rễ (túi thành phẩm T01/T05), không bắt buộc — null nghĩa là không giới hạn.
  capacity    Int?
  // Chỉ ràng buộc với kệ trong Phòng mẫu mẹ (SUPER_ADMIN cấu hình) — 1 kệ chỉ xếp 1 mã cây và
  // gắn với 1 nhân viên cấy mô cụ thể. Kệ Phòng ra rễ không dùng 2 field này (luôn null).
  plantTypeId String?
  plantType   PlantType? @relation(fields: [plantTypeId], references: [id])
  assignedStaffId String?
  assignedStaff   User?  @relation("ShelfAssignedStaff", fields: [assignedStaffId], references: [id])
  // Chỉ áp dụng cho kệ "chung" (assignedStaffId null) trong Phòng mẫu mẹ — phân nhóm Kho quá hạn/đúng
  // hạn trong "Kho mẫu mẹ chung" (không phải Room riêng, chỉ là cờ trên kệ). Kệ "đã chia" luôn null.
  sharedMotherPool SharedMotherPool?
  // "Cho phép xếp" — chỉ áp dụng cho kệ "chung" (assignedStaffId null) trong Phòng mẫu mẹ, SUPER_ADMIN
  // nhập tay danh sách chuỗi (VD ["EP","HM","AT","MT041"]). MM dư trả về Kho mẫu mẹ chung được xếp vào
  // kệ có ít nhất 1 chuỗi trong danh sách là TIỀN TỐ của mã chi tiết loại cây (VD "MT" khớp mọi mã
  // MT001/MT005/MT041..., "MT041" chỉ khớp đúng mã đó) — thay thế hoàn toàn cho plantTypeId ở kệ chung
  // (kệ "đã chia" vẫn dùng plantTypeId như cũ, không đổi). Mảng rỗng = chưa cấu hình.
  allowedCodes String[] @default([])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lots             Lot[]
  instructionItems PlantingInstructionItem[]
  repackAsSource   RepackInstruction[] @relation("RepackSourceShelf")
  repackAsOutput   RepackInstruction[] @relation("RepackActualOutputShelf")

  @@map("shelves")
}

// Nhóm gộp các kệ giàn kệ lẻ lại với nhau (VD kệ A1C10 + B1C09 = 1 Nhóm, không cần cùng block) —
// thuộc tính không bắt buộc, chỉ Admin cấp cao (SUPER_ADMIN) cài đặt qua trang /settings/shelf-groups.
// Có thể gộp kệ từ nhiều block/phòng/kho khác nhau vào cùng 1 Nhóm.
model ShelfGroup {
  id        String   @id @default(cuid())
  name      String
  // Loại nhóm — nhập tự do, không bắt buộc, chỉ để Admin cấp cao tự phân loại/ghi chú thêm (VD "Khu
  // sản xuất chính", "Khu dự trữ"...), không ràng buộc nghiệp vụ nào khác. Không dùng để xác định cơ chế
  // xoay vòng (xem rotationKind bên dưới) — 1 Nhóm có thể vừa có type tự do vừa có rotationKind.
  type      String?
  // Có giá trị = Nhóm này là 1 "khe" trong cơ chế xoay vòng Nhóm tuần ra rễ/Nhóm tuần mẫu mẹ (SUPER_ADMIN
  // cấu hình qua /settings/shelf-groups) — xem Shelf.rotationGroupId. null = Nhóm gộp kệ tự do thông
  // thường, không tham gia xoay vòng.
  rotationKind  ShelfGroupRotationKind?
  // Vị trí (1-based) trong chu kỳ xoay vòng của ĐÚNG rotationKind này — tổng số khe N = số Nhóm đang có
  // cùng rotationKind (VD 4 Nhóm "Nhóm tuần ra rễ" → N=4, 6 Nhóm "Nhóm tuần mẫu mẹ" → N=6, không hard-code
  // 4 như trước). Chỉ có ý nghĩa khi rotationKind khác null.
  rotationOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shelves         Shelf[] @relation("ShelfPhysicalGroup")
  rotationShelves Shelf[] @relation("ShelfRotationGroup")

  @@map("shelf_groups")
}

// ============================================================
// LOTS
// ============================================================

model Lot {
  id              String     @id @default(cuid())
  // Không unique riêng lẻ — mã lô = mã cây + mã NV cấy + mã tuần/năm (VD "AL001003" + "0726"), NHIỀU lô có
  // thể dùng chung 1 mã nếu cùng chỉ định/tuần nhưng khác quy cách (VD M05 và T05 vẫn là 2 dòng Lot
  // riêng, chỉ đính cùng mã lô để NV nhìn biết chúng thuộc cùng 1 đợt cấy). Duy nhất theo (code, stageCode).
  code            String
  plantTypeId     String
  plantType       PlantType  @relation(fields: [plantTypeId], references: [id])
  stage           PlantStage
  stageCode       String

  shelfId         String?
  shelf           Shelf?     @relation(fields: [shelfId], references: [id])
  // Chỉ dùng cho Kho thành phẩm (không quản lý theo giàn kệ) — lô gắn thẳng vào Phòng (Khả dụng/Theo
  // dõi/Hàn túi/Thị trường), không qua Shelf. Kho sản xuất luôn dùng shelfId ở trên, roomId luôn null.
  roomId          String?
  room            Room?      @relation("LotDirectRoom", fields: [roomId], references: [id])

  quantity        Int
  initialQuantity Int
  status          LotStatus  @default(ACTIVE)

  enteredAt       DateTime   @default(now())
  // Ngày nhập kho tối GỐC (bất biến, không đổi theo vòng đời lô) — TÁCH RIÊNG khỏi enteredAt vì
  // enteredAt bị commitShelfPlacements (src/lib/dark-room-shelf-commit.ts) GHI ĐÈ thành thời điểm lên kệ
  // kho sáng mỗi khi Kho mô xác nhận bàn giao (để tính đúng hạn "đến lịch chuyển kho tiếp theo" từ lúc
  // lên kệ, không phải lúc nhập kho tối) — nếu không tách riêng, mọi nơi hiển thị "Ngày nhập kho tối" cho
  // lô ĐÃ lên kệ sẽ hiện sai thành ngày lên kệ (xem handover-history.tsx, phát hiện qua báo lỗi thực tế:
  // "ngày bàn giao 03/08 nhưng ngày nhập kho tối lại 04/08" — vô lý vì nhập kho tối phải TRƯỚC bàn giao).
  // Set 1 LẦN DUY NHẤT lúc tạo lô (mọi nơi prisma.lot.create khi lô vào Phòng tối), KHÔNG BAO GIỜ update
  // lại sau đó. Null với lô tạo trước khi có field này (không khôi phục được ngày gốc đã mất) hoặc lô
  // không thuộc luồng Phòng tối (VD lô Phòng nhiễm, lô Kho thành phẩm nhập trực tiếp) — nơi hiển thị nên
  // fallback về enteredAt nếu null.
  darkRoomEnteredAt DateTime?
  expectedMoveAt  DateTime?
  // Chỉ có giá trị khi status = PLANNED — ngày dự kiến hàng thật về, lấy từ GoodsReceipt.expectedDate lúc
  // tạo Kế hoạch nhập kho. Dùng so sánh với Order.expectedShipAt để quyết định lô này có tính vào khả
  // dụng cho 1 đơn hàng cụ thể hay không (xem getQualifiedLots ở src/lib/order-availability.ts). Xoá về
  // null khi lô được xác nhận chuyển ACTIVE.
  expectedDate    DateTime?

  // Kiểm tra nhiễm phòng tối cá nhân — null = Chưa kiểm tra, khác null = Đã kiểm tra (cùng convention
  // với ContaminationRecord.confirmedAt). Bắt buộc trước khi được chọn bàn giao từ phòng tối.
  inspectedAt     DateTime?
  inspectedById   String?
  inspectedBy     User?      @relation("LotInspectedBy", fields: [inspectedById], references: [id])

  parentLotId     String?
  parentLot       Lot?       @relation("LotChildren", fields: [parentLotId], references: [id])
  childLots       Lot[]      @relation("LotChildren")

  instructionId   String?
  instruction     PlantingInstruction? @relation(fields: [instructionId], references: [id])

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  dailyRecordItems    DailyRecordItem[]
  transferItems       TransferItem[]
  orderItems          OrderItem[]
  contaminations      ContaminationRecord[]
  instructionItems    PlantingInstructionItem[]
  inspectionItems     LotInspectionItem[]
  processingOutputTickets ProcessingTicket[]
  processingInputRows     ProcessingTicketInputLot[]
  orderProcessingRequestsAsSource OrderProcessingRequest[]
  // Ngược của GoodsReceiptItem.plannedLotId — chỉ có giá trị khi lô này là lô "ảo" do 1 Kế hoạch nhập
  // kho tạo ra (status = PLANNED).
  goodsReceiptPlan GoodsReceiptItem?
  repackAsSource   RepackInstruction[] @relation("RepackSourceLot")
  repackAsOutput   RepackInstruction[] @relation("RepackOutputLot")

  @@unique([code, stageCode])
  @@map("lots")
}

// ============================================================
// PLANTING INSTRUCTIONS
// ============================================================

model PlantingInstruction {
  id            String            @id @default(cuid())
  code          String            @unique
  plantTypeId   String
  plantType     PlantType         @relation(fields: [plantTypeId], references: [id])
  // Môi trường nay chọn riêng theo từng dòng quy cách nguồn (M3/M5) — xem PlantingInstructionItem,
  // vì mỗi quy cách có thể dùng môi trường nhân mẫu mẹ / ra rễ khác nhau.

  createdById   String
  createdBy     User              @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId  String?
  assignedTo    User?             @relation("AssignedTo", fields: [assignedToId], references: [id])

  // Tổng đầu vào/dự kiến cộng dồn từ tất cả các dòng quy cách nguồn (items) — 1 chỉ định có thể dùng nhiều
  // quy cách nguồn (VD: cùng 1 kệ có cả M3 và M5), mỗi dòng tự có tỉ lệ riêng — xem PlantingInstructionItem.
  inputMotherQuantity     Int
  expectedMotherOutput    Int?
  expectedFinishedOutput  Int?

  // Kế hoạch phân bổ thành phẩm dự kiến theo quy cách đóng gói — KY_THUAT nhập lúc tạo chỉ định,
  // tổng nên khớp expectedFinishedOutput. Lô thành phẩm thật sự tạo ra khi NV cấy nhập nhật ký hàng ngày
  // có thể mang quy cách T01 hoặc T05 tùy NV chọn — 2 số này chỉ là kế hoạch để đối chiếu.
  plannedT01Quantity      Int?
  plannedT05Quantity      Int?

  status      InstructionStatus @default(DRAFT)
  weekStart   DateTime?
  notes       String?

  // Kho mô bấm nút "Bàn giao" thì mới coi là ĐÃ bàn giao — khác với việc assignedToId đã có giá trị
  // (kệ "đã chia" tự động điền sẵn NV mặc định lúc tạo chỉ định, nhưng CHƯA phải đã bàn giao thật).
  // null = "Chưa bàn giao" dù assignedToId có thể đã có sẵn.
  handedOverAt DateTime?
  // NV kho mô đã thực hiện bàn giao — dùng để in đúng tên/vị trí "Bên giao" trên Phiếu chỉ định sản
  // xuất (khác với người đang xem trang, có thể là KY_THUAT hoặc Admin).
  handedOverById String?
  handedOverBy   User?     @relation("HandedOverBy", fields: [handedOverById], references: [id])

  // NV cấy mô (assignedTo) bấm xác nhận sau khi nhận mẫu mẹ do KHO_MO xuất/bàn giao — dùng để
  // tính % hoàn thành việc "Bàn giao mẫu mẹ" trên dashboard của KHO_MO.
  motherReceivedAt DateTime?

  // Lý do chuyển ENDED — chỉ có giá trị khi status = ENDED. TIME_UP: hết ngày Chủ nhật của tuần chỉ
  // định (kiểm tra ngay khi NV cấy mô bấm "Lưu dữ liệu hôm nay"). MOTHER_USED_UP: tổng "MM sử dụng"
  // đã đạt/vượt inputMotherQuantity. EARLY_END_BY_STAFF: NV cấy mô tự bấm kết thúc sớm.
  endReason        InstructionEndReason?
  // NV cấy mô bấm "Bàn giao MM dư" (áp dụng khi endReason = TIME_UP hoặc EARLY_END_BY_STAFF và còn dư
  // — 2 lý do duy nhất có thể còn MM chưa dùng hết) — set khi đã tạo Transfer bàn giao phần mẫu mẹ dư
  // cho Kho mô, tránh bàn giao lặp lại.
  surplusHandedOverAt DateTime?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Chỉ định cấy dự phòng — nhiệm vụ tuần của KY_THUAT: tạo tối thiểu 5 chỉ định dự phòng cho tuần sau
  // trước Thứ 5 tuần này, nguồn LUÔN lấy từ kệ mẫu mẹ "chung" chưa chia (Shelf.assignedStaffId = null),
  // chưa gắn NV cụ thể lúc tạo — dùng khi NV cấy mô đăng ký làm thêm/hoàn thành sớm (xem
  // ExtraWorkRequest.fulfilledInstructionId). Xem POST /api/instructions, getKyThuatStats.
  isBackup    Boolean           @default(false)

  items               PlantingInstructionItem[]
  lots                Lot[]
  dailyRecords        DailyRecord[]

  // Nhiều chỉ định cùng tuần thực hiện (weekStart) gộp chung vào 1 đơn đặt hàng môi trường — xem
  // MediumOrder. null nếu chỉ định không cần môi trường nào (hiếm).
  mediumOrderId String?
  mediumOrder   MediumOrder? @relation(fields: [mediumOrderId], references: [id])

  extraWorkRequests          ExtraWorkRequest[] @relation("ExtraWorkRequestCurrentInstruction")
  fulfilledExtraWorkRequests ExtraWorkRequest[] @relation("ExtraWorkRequestFulfilledInstruction")

  @@map("planting_instructions")
}

// 1 dòng = 1 quy cách nguồn (M3 hoặc M5) dùng trong chỉ định. 1 kệ có thể sinh nhiều dòng
// (VD: kệ có cả M3 và M5) vì mỗi quy cách có tỉ lệ nhân/ra rễ riêng.
model PlantingInstructionItem {
  id            String              @id @default(cuid())
  instructionId String
  instruction   PlantingInstruction @relation(fields: [instructionId], references: [id])
  shelfId       String
  shelf         Shelf               @relation(fields: [shelfId], references: [id])
  lotId         String?
  lot           Lot?                @relation(fields: [lotId], references: [id])
  stageCode     String? // "M05" (chỉ còn 1 quy cách mẫu mẹ, đã bỏ M03)
  quantity      Int

  motherSampleRatio      Float?
  rootingRatio           Float?
  expectedMotherOutput   Int?
  expectedFinishedOutput Int?

  // Môi trường riêng cho dòng quy cách này: 1 để nhân thêm mẫu mẹ, 1 để ra rễ thành cây thành phẩm.
  motherMediumTypeId     String?
  motherMedium           MediumType? @relation("ItemMotherMedium", fields: [motherMediumTypeId], references: [id])
  finishedMediumTypeId   String?
  finishedMedium         MediumType? @relation("ItemFinishedMedium", fields: [finishedMediumTypeId], references: [id])

  @@map("planting_instruction_items")
}

// ============================================================
// REPACK INSTRUCTIONS — "Chỉ định cấy xử lý": đóng gói lại hàng THÀNH PHẨM đã có sẵn trên 1 kệ Phòng ra
// rễ từ quy cách này sang quy cách khác (VD T05 -> T01), KHÔNG liên quan mẫu mẹ/chu kỳ tuần. Chạy SONG
// SONG với PlantingInstruction của NV cấy mô — model độc lập hoàn toàn, không có FK/quan hệ nào tới
// PlantingInstruction/ExtraWorkRequest, nên không bao giờ lọt vào các query "1 chỉ định tại 1 thời điểm"
// (PATCH /api/instructions/[id] nhánh confirmMotherReceived) hay activeInstructionThisWeek
// (src/lib/cay-mo-quest-stats.ts) — cả 2 chỉ đọc bảng planting_instructions.
// ============================================================

// Trạng thái vòng đời — luồng tuyến tính, KHÔNG có khái niệm tuần/auto-end như PlantingInstruction (thời
// lượng ngắn 1-2 ngày, không cần sweep tự động — xem RepackInstruction.staffConfirmedAt).
enum RepackInstructionStatus {
  CREATED           // KY_THUAT vừa tạo, chưa gán NV cấy mô
  ASSIGNED          // Kho mô đã chọn NV cấy mô, chờ NV xác nhận "Nhận bàn giao"
  IN_PROGRESS       // NV đã xác nhận nhận — ĐÃ trừ inputQuantity khỏi lô nguồn, đang xử lý
  PENDING_PLACEMENT // NV đã bàn giao kết quả (đạt/không đạt tự khai) — chờ Kho mô kiểm tra + sắp xếp
  COMPLETED         // Kho mô đã sắp xếp xong lên kệ — kết thúc vòng đời
  CANCELLED         // Hủy trước khi NV xác nhận nhận (không cần hoàn tồn kho)
}

model RepackInstruction {
  id          String    @id @default(cuid())
  code        String    @unique
  plantTypeId String
  plantType   PlantType @relation(fields: [plantTypeId], references: [id])

  // Kệ + lô nguồn CỤ THỂ trong Phòng ra rễ (không qua thuật toán chọn kệ) — cũng là đích "gợi ý" mặc định
  // khi Kho mô sắp xếp thành phẩm quay lại (xem actualOutputShelfId, src/lib/repack-placement.ts).
  sourceShelfId String
  sourceShelf   Shelf  @relation("RepackSourceShelf", fields: [sourceShelfId], references: [id])
  sourceLotId   String
  sourceLot     Lot    @relation("RepackSourceLot", fields: [sourceLotId], references: [id])

  inputStageCode String // VD "T05" — quy cách của sourceLot lúc tạo, lấy từ sourceLot (không tin client)
  // Số CÂY (không phải số túi — Lot.quantity của thành phẩm luôn tính theo cây trong toàn hệ thống, xem
  // FINISHED_SPEC_BAG_SIZE ở src/types/index.ts) — sẽ bị trừ khỏi sourceLot NGAY LÚC NV cấy mô xác nhận
  // "Nhận bàn giao" (staffConfirmedAt), KHÁC thời điểm trừ của PlantingInstruction (trừ lúc Kho mô bàn
  // giao, không phải lúc NV tự xác nhận nhận).
  inputQuantity Int
  // VD "T01" — quy cách đích, luôn khác inputStageCode (validate ở POST /api/repack-instructions).
  outputStageCode String
  // = inputQuantity — đóng gói lại KHÔNG sinh thêm cây, lưu tường minh để đối chiếu đạt/không đạt.
  expectedOutputQuantity Int

  createdById String
  createdBy   User     @relation("RepackCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  // Kho mô (KHÔNG phải KY_THUAT) tự chọn NV cấy mô thực hiện — mirror nhánh assignedToId của "kệ chung"
  // ở PATCH /api/instructions/[id], KHÔNG qua ExtraWorkRequest/chỉ định dự phòng.
  assignedToId String?
  assignedTo   User?     @relation("RepackAssignedTo", fields: [assignedToId], references: [id])
  assignedById String?
  assignedBy   User?     @relation("RepackAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime?

  // NV cấy mô tự bấm "Nhận bàn giao" — ĐÂY là mốc trừ tồn kho (xem inputQuantity ở trên).
  staffConfirmedAt DateTime?

  // NV cấy mô bấm "Số lượng không đủ" thay vì "Nhận bàn giao" — số cây thực tế thấy trên kệ KHÔNG khớp
  // inputQuantity ghi trên chỉ định. KHÔNG trừ tồn kho (chưa từng xác nhận nhận), chỉ đưa chỉ định về lại
  // status CREATED (huỷ gán, xem PATCH /api/repack-instructions/[id] nhánh reportInsufficientQuantity) +
  // báo cho đúng Kho mô đã gán (assignedById lúc đó) qua Alert REPACK_QUANTITY_MISMATCH để kiểm tra lại
  // kệ trước khi gán lại. Giữ lại field này sau khi status đã đổi để còn hiển thị lý do/audit trail cho
  // Kho mô xem khi gán lại (assignedToId/assignedById/assignedAt đã bị xoá về null lúc đó).
  quantityIssueReportedAt   DateTime?
  quantityIssueReportedById String?
  quantityIssueReportedBy   User?     @relation("RepackQuantityIssueReportedBy", fields: [quantityIssueReportedById], references: [id])
  quantityIssueNote         String?

  // NV cấy mô tự khai kết quả CUỐI CÙNG (1 lần duy nhất khi bấm "Hoàn thành – Bàn giao kết quả", không
  // có bảng ngày như DailyRecord — công việc ngắn 1-2 ngày, chỉ cần 1 con số kết quả sau cùng).
  staffHandedBackAt      DateTime?
  reportedPassedQuantity Int?
  reportedFailedQuantity Int?

  // Kho mô kiểm tra lại (mức độ review tương tự chỉ định thường) — có thể giữ nguyên hoặc sửa số NV tự
  // khai trước khi tính lương. Không chia luồng Xanh/Đỏ như TransferInspection — luôn kiểm tra 1 bước.
  khoMoInspectedAt        DateTime?
  khoMoInspectedById      String?
  khoMoInspectedBy        User?     @relation("RepackInspectedBy", fields: [khoMoInspectedById], references: [id])
  confirmedPassedQuantity Int?
  confirmedFailedQuantity Int?
  // = confirmedPassedQuantity — chỉ số "đạt" DUY NHẤT tính lương/năng suất (không đạt vẫn được xếp kho
  // thật ở bước Sắp xếp, chỉ không tính công — cùng nguyên tắc TransferItem.unqualifiedQuantity).
  creditedQuantity Int?

  // Kho mô "Sắp xếp" — LUÔN gợi ý mặc định đúng sourceShelfId trước, chỉ đổi sang kệ khác nếu kệ gốc hết
  // chỗ (Kho mô tự nhập mã kệ khác — xem src/lib/repack-placement.ts).
  placedAt            DateTime?
  placedById          String?
  placedBy            User?   @relation("RepackPlacedBy", fields: [placedById], references: [id])
  actualOutputShelfId String?
  actualOutputShelf   Shelf?  @relation("RepackActualOutputShelf", fields: [actualOutputShelfId], references: [id])
  outputLotId         String?
  outputLot           Lot?    @relation("RepackOutputLot", fields: [outputLotId], references: [id])

  // Đăng ký hoàn thành sớm/làm thêm (ExtraWorkRequest) đã được Kho mô "dùng" để gán NV cho ĐÚNG chỉ định
  // này — xem ExtraWorkRequest.fulfilledRepackInstructionId, PATCH nhánh assignExtraWorkRequestId.
  extraWorkRequestsFulfilled ExtraWorkRequest[] @relation("ExtraWorkRequestFulfilledRepackInstruction")

  status    RepackInstructionStatus @default(CREATED)
  notes     String?
  updatedAt DateTime                @updatedAt

  @@map("repack_instructions")
}

// ============================================================
// MEDIUM ORDERS — đơn đặt hàng môi trường tự động sinh khi KY_THUAT tạo chỉ định cấy
// (KY_THUAT tạo chỉ định -> tự sinh đơn cho MOI_TRUONG -> MOI_TRUONG xác nhận + pha theo
// từng ngày trong tuần -> bàn giao từng ngày -> KHO_MO xác nhận nhận).
// ============================================================

model MediumOrder {
  id String @id @default(cuid())
  code String @unique

  // Nhiều chỉ định cùng tuần thực hiện (PlantingInstruction.weekStart) được gộp vào 1 đơn — KY_THUAT
  // thường ra nhiều chỉ định trước Thứ 5 tuần này, tất cả dùng cho tuần sau, nên chỉ cần 1 đơn chung.
  instructions PlantingInstruction[]

  // Khung tuần pha môi trường: weekStart = Thứ 6 của tuần TẠO chỉ định (3 ngày trước tuần thực hiện),
  // weekEnd = Thứ 6 của tuần thực hiện (weekStart + 7). VD: chỉ định dùng cho tuần thực hiện bắt đầu Thứ
  // 2 tới -> weekStart = Thứ 6 tuần này, weekEnd = Thứ 6 tuần sau. Sinh sẵn 8 dòng MediumOrderDay.
  weekStart DateTime
  weekEnd   DateTime

  // MOI_TRUONG bấm "Xác nhận" mới coi là ĐÃ nhận đơn — null = "Chưa xác nhận", có giá trị = "Đang thực hiện".
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?     @relation("MediumOrderConfirmedBy", fields: [confirmedById], references: [id])

  createdAt DateTime @default(now())

  items MediumOrderItem[]
  days  MediumOrderDay[]

  @@map("medium_orders")
}

// 1 dòng = 1 quy cách (M05/T01/T05) cần pha cho đơn này, kèm mã môi trường tương ứng — hiển thị
// ở đầu trang chi tiết đơn để MOI_TRUONG biết cần pha bao nhiêu, loại nào.
model MediumOrderItem {
  id           String      @id @default(cuid())
  orderId      String
  order        MediumOrder @relation(fields: [orderId], references: [id])
  stageCode    String // "M05" | "T01" | "T05"
  mediumTypeId String
  mediumType   MediumType  @relation(fields: [mediumTypeId], references: [id])
  quantity     Int

  @@map("medium_order_items")
}

// 1 dòng = 1 ngày trong tuần pha (8 dòng/đơn, xem MediumOrder.weekStart/weekEnd). MOI_TRUONG điền số
// đã pha mỗi ngày rồi bấm "Bàn giao" (handedOverAt) — khoá không sửa số được nữa; KHO_MO xác nhận
// (confirmedAt) mới coi là "Bàn giao thành công". Chỉ còn 1 quy cách mẫu mẹ (M05) — đã bỏ field m03
// (gộp vào m05 khi migrate, xem prisma/migrate-m03-to-m05.ts).
model MediumOrderDay {
  id      String      @id @default(cuid())
  orderId String
  order   MediumOrder @relation(fields: [orderId], references: [id])
  date    DateTime

  m05 Int @default(0)
  t01 Int @default(0)
  t05 Int @default(0)

  handedOverAt  DateTime?
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?     @relation("MediumOrderDayConfirmedBy", fields: [confirmedById], references: [id])

  @@unique([orderId, date])
  @@map("medium_order_days")
}

// ============================================================
// DAILY RECORDS
// ============================================================

model DailyRecord {
  id            String              @id @default(cuid())
  instructionId String
  instruction   PlantingInstruction @relation(fields: [instructionId], references: [id])
  staffId       String
  staff         User                @relation(fields: [staffId], references: [id])
  recordDate    DateTime            @default(now())
  motherUsed    Int
  // "MM đã kiểm tra" / "MM mẹ nhiễm" trên bảng nhập liệu tuần của NV cấy mô — nhập tay mỗi ngày,
  // không suy ra được từ ContaminationRecord (model đó theo dõi nhiễm ở cấp Lot, khác cấp/khác lúc).
  // Chỉ còn 1 quy cách mẫu mẹ (M05) — đã bỏ field motherContaminatedM03 (gộp vào field này khi migrate,
  // xem prisma/migrate-m03-to-m05.ts), tên field giữ nguyên "M05" để không phải đổi khắp codebase.
  motherChecked         Int         @default(0)
  motherContaminatedM05 Int         @default(0)
  notes         String?
  createdAt     DateTime            @default(now())

  items DailyRecordItem[]

  @@map("daily_records")
}

model DailyRecordItem {
  id              String      @id @default(cuid())
  dailyRecordId   String
  dailyRecord     DailyRecord @relation(fields: [dailyRecordId], references: [id])
  lotId           String
  lot             Lot         @relation(fields: [lotId], references: [id])
  stage           PlantStage
  quantityCreated Int

  @@map("daily_record_items")
}

// ============================================================
// CONTAMINATION RECORDS
// ============================================================

model ContaminationRecord {
  id            String    @id @default(cuid())
  lotId         String
  lot           Lot       @relation(fields: [lotId], references: [id])
  quantity      Int
  recordDate    DateTime  @default(now())
  confirmedAt   DateTime?
  confirmedById String?
  notes         String?
  createdAt     DateTime  @default(now())

  @@map("contamination_records")
}

// Kho mô đề xuất Trồng lại hoặc Hủy bỏ 1 phần số lượng đang nằm ở Phòng nhiễm (theo mã cây + quy cách)
// của kho sản xuất mình đang làm việc — gửi Admin cấp cao/Admin duyệt. Số lượng bị trừ ngay khỏi Phòng
// nhiễm lúc gửi đề xuất (xem POST /api/contamination-proposals); nếu bị từ chối sẽ hoàn lại.
model ContaminationProposal {
  id            String                       @id @default(cuid())
  code          String                       @unique
  // Mã của đề xuất gộp (nhiều dòng cây gửi cùng 1 lần bấm "Gửi đề xuất") — mặc định = code của dòng đầu
  // tiên trong lần gửi đó (xem POST /api/contamination-proposals). NULL với các dòng tạo trước khi có
  // tính năng gộp — khi hiển thị coi như 1 batch riêng lẻ (dùng chính code của nó).
  batchCode     String?
  type          ContaminationProposalType
  warehouseId   String
  warehouse     Warehouse                    @relation(fields: [warehouseId], references: [id])
  plantTypeId   String
  plantType     PlantType                    @relation(fields: [plantTypeId], references: [id])
  stageCode     String
  quantity      Int
  status        ContaminationProposalStatus  @default(PENDING)
  notes         String?
  requestedById String
  requestedBy   User                         @relation("ContaminationProposalRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?                        @relation("ContaminationProposalApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@map("contamination_proposals")
}

// Lịch sử TỪNG LẦN cộng nhiễm vào Phòng nhiễm — Phòng nhiễm (Lot code "NHIEM-{khoCode}-{maCay}") chỉ
// lưu 1 dòng GỘP theo (kho, mã cây, quy cách) để dễ quản lý tồn (xem addToContaminationRoom ở
// src/lib/contamination-room.ts), nhưng cần truy vết được TỪNG LẦN báo nhiễm cụ thể (ai báo, từ lô nào,
// lúc nào, bao nhiêu, vì sao) — gọi từ nhiều luồng khác nhau (tự kiểm tra nhiễm phòng tối, nhập dữ liệu
// cấy hàng ngày, sửa nhật ký, kiểm tra luồng Đỏ lúc nhận bàn giao, nhập liệu Excel, hoàn lại do đề xuất
// bị từ chối). quantity có thể ÂM (điều chỉnh giảm khi sửa nhật ký) — tổng các dòng của 1
// contaminationLotId luôn khớp đúng Lot.quantity hiện tại của lô gộp đó.
model ContaminationRoomEntry {
  id                 String                   @id @default(cuid())
  contaminationLotId String
  quantity           Int
  sourceLotId        String?
  sourceLotCode      String?
  reportedById       String
  reportedBy         User                     @relation(fields: [reportedById], references: [id])
  reason             ContaminationEntryReason
  createdAt          DateTime                 @default(now())

  @@index([contaminationLotId])
  @@map("contamination_room_entries")
}

enum ContaminationEntryReason {
  DARK_ROOM_SELF_CHECK // NV cấy mô tự kiểm tra nhiễm ở phòng tối trước bàn giao
  DAILY_RECORD // Nhập dữ liệu cấy hàng ngày (motherContaminatedM05)
  DAILY_RECORD_EDIT // Sửa/bù nhật ký cấy — điều chỉnh tăng hoặc giảm (quantity có thể âm)
  RED_LANE_INSPECTION // Kho mô kiểm tra luồng Đỏ lúc nhận bàn giao Phòng tối
  EXCEL_IMPORT // Nhập liệu Excel hàng loạt
  PROPOSAL_REJECTED_REFUND // Hoàn lại do đề xuất Trồng lại/Hủy bị từ chối
}

// ============================================================
// EXTRA WORK REQUESTS — NV cấy mô đăng ký cấy thêm (dùng khi cấy nhanh hết chỉ định được giao hoặc
// muốn đăng ký làm thêm ngoài giờ/Chủ nhật) — gửi cho KHO_MO cùng kho sản xuất xác nhận/duyệt.
// ============================================================

enum ExtraWorkRequestType {
  // Báo trước cho KHO_MO biết sắp cấy xong chỉ định đang thực hiện, để chuẩn bị bàn giao chỉ định mới
  // sớm hơn dự kiến — chỉ mang tính thông báo, KHO_MO chỉ có 1 hành động "Xác nhận" (không có từ chối).
  EARLY_COMPLETION
  // Đăng ký làm thêm ngoài giờ hành chính hoặc Chủ nhật — KHO_MO xét duyệt Đồng ý/Từ chối.
  OVERTIME
}

enum WorkSession {
  SANG
  CHIEU
}

enum ExtraWorkRequestStatus {
  PENDING
  APPROVED // EARLY_COMPLETION dùng chung giá trị này cho hành động "Xác nhận"
  REJECTED // Chỉ áp dụng cho OVERTIME — EARLY_COMPLETION không có đường REJECTED
}

model ExtraWorkRequest {
  id     String               @id @default(cuid())
  type   ExtraWorkRequestType
  staffId String
  staff   User                @relation("ExtraWorkRequestStaff", fields: [staffId], references: [id])

  // Chỉ dùng cho EARLY_COMPLETION — chỉ định đang thực hiện của NV tại lúc gửi đăng ký (server tự suy ra,
  // không cho client chọn tay để tránh chọn nhầm chỉ định của NV khác).
  instructionId      String?
  instruction        PlantingInstruction? @relation("ExtraWorkRequestCurrentInstruction", fields: [instructionId], references: [id])
  expectedEndDate    DateTime?
  expectedEndSession WorkSession?

  // Chỉ dùng cho OVERTIME — nhiều dòng ngày/giờ trong 1 lần đăng ký, xem ExtraWorkSlot.
  slots ExtraWorkSlot[]

  status        ExtraWorkRequestStatus @default(PENDING)
  respondedById String?
  respondedBy   User?                  @relation("ExtraWorkRequestRespondedBy", fields: [respondedById], references: [id])
  respondedAt   DateTime?

  // Đăng ký đã APPROVED được Kho mô "dùng" để gán vào 1 chỉ định cấy dự phòng HOẶC 1 chỉ định cấy xử lý
  // (xem PlantingInstruction.isBackup, PATCH /api/instructions/[id] nhánh assignExtraWorkRequestId; và
  // RepackInstruction, PATCH /api/repack-instructions/[id] nhánh cùng tên) — null ở CẢ 2 field dưới dù đã
  // APPROVED nghĩa là còn "khả dụng" (xem GET /api/extra-work-requests?availableToAssign=true), chưa NV
  // nào được gán việc thật từ đăng ký này. fulfilledAt dùng CHUNG cho cả 2 loại (chỉ đánh dấu "đã dùng"),
  // chỉ 1 trong 2 field Id dưới được set tuỳ đã dùng cho loại chỉ định nào — ngăn 1 đăng ký bị dùng gán
  // trùng cho nhiều việc khác nhau bất kể loại.
  fulfilledAt                  DateTime?
  fulfilledInstructionId       String?
  fulfilledInstruction         PlantingInstruction? @relation("ExtraWorkRequestFulfilledInstruction", fields: [fulfilledInstructionId], references: [id])
  fulfilledRepackInstructionId String?
  fulfilledRepackInstruction   RepackInstruction?   @relation("ExtraWorkRequestFulfilledRepackInstruction", fields: [fulfilledRepackInstructionId], references: [id])

  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@map("extra_work_requests")
}

// 1 dòng ngày/giờ trong đăng ký làm thêm ngoài giờ (ExtraWorkRequest type = OVERTIME) — NV bấm "Thêm
// hàng" để đăng ký nhiều ngày trong cùng 1 lần gửi. startTime/endTime lưu dạng "HH:mm" (giờ trong ngày
// thuần, không cần combine với date thành DateTime đầy đủ).
model ExtraWorkSlot {
  id        String           @id @default(cuid())
  requestId String
  request   ExtraWorkRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String
  endTime   String

  @@map("extra_work_slots")
}

// ============================================================
// LOT INSPECTIONS (kiểm tra nhiễm phòng tối cá nhân)
// ============================================================

model LotInspection {
  id                   String   @id @default(cuid())
  // Lot.code của "lô sản phẩm" được kiểm tra — 1 phiếu gộp tất cả quy cách (M05/T01/T05) cùng
  // sinh ra trong 1 lần nhập số liệu cấy (xem generateProductLotCode).
  code                 String
  staffId              String
  staff                User     @relation(fields: [staffId], references: [id])
  totalQuantity        Int
  contaminatedQuantity Int
  passedQuantity       Int
  createdAt            DateTime @default(now())

  items                LotInspectionItem[]

  @@map("lot_inspections")
}

model LotInspectionItem {
  id                   String        @id @default(cuid())
  inspectionId         String
  inspection           LotInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  lotId                String
  lot                  Lot           @relation(fields: [lotId], references: [id])
  stageCode            String
  initialQuantity      Int
  contaminatedQuantity Int
  passedQuantity       Int

  @@map("lot_inspection_items")
}

// ============================================================
// TRANSFERS
// ============================================================

model Transfer {
  id              String         @id @default(cuid())
  code            String         @unique
  fromWarehouseId String?
  fromWarehouse   Warehouse?     @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  fromRoomId      String?
  fromRoom        Room?          @relation("TransferFromRoom", fields: [fromRoomId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  toRoomId        String?
  toRoom          Room?          @relation("TransferToRoom", fields: [toRoomId], references: [id])
  fromUserId      String
  fromUser        User           @relation("TransferFrom", fields: [fromUserId], references: [id])
  toUserId        String?
  toUser          User?          @relation("TransferTo", fields: [toUserId], references: [id])
  status          TransferStatus @default(PENDING)
  notes           String?
  transferredAt   DateTime       @default(now())
  confirmedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items      TransferItem[]
  inspection TransferInspection?

  @@map("transfers")
}

// Kho mô tự kiểm tra lại số lượng/chất lượng khi nhận bàn giao Phòng tối của NV luồng Đỏ/chưa cài
// đặt luồng (luồng Xanh bỏ qua bước này — coi như tự động tin tưởng) — 1 phiếu bàn giao 1 phiếu
// kiểm tra. Sau khi xác nhận, đi tiếp bước "Sắp xếp về kho" (xem src/lib/receive-phong-toi.ts).
model TransferInspection {
  id            String   @id @default(cuid())
  transferId    String   @unique
  transfer      Transfer @relation(fields: [transferId], references: [id])
  inspectedById String
  inspectedBy   User     @relation("TransferInspectedBy", fields: [inspectedById], references: [id])
  createdAt     DateTime @default(now())

  items TransferInspectionItem[]

  @@map("transfer_inspections")
}

model TransferInspectionItem {
  id                   String             @id @default(cuid())
  inspectionId         String
  inspection           TransferInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  stageCode            String
  handedOverQuantity   Int
  contaminatedQuantity Int
  passedQuantity       Int
  randomCheckPassRate  Float
  // NV cấy mô tự khai "không đạt" (VD cây thành phẩm quá nhỏ) lúc bàn giao (xem
  // TransferItem.unqualifiedQuantity) — Kho mô xác nhận/sửa lại ở đây cho luồng Đỏ (luồng Xanh không qua
  // bước này, tin tưởng tuyệt đối số NV tự khai). CHỈ áp dụng cho quy cách thành phẩm (T01/T05) — mẫu mẹ
  // (M05) luôn coi là đạt hết, giữ 0.
  unqualifiedQuantity  Int                @default(0)
  // = round(randomCheckPassRate/100 * handedOverQuantity) − unqualifiedQuantity (không âm) — chỉ dùng
  // tính lương sau này, KHÔNG dùng để trừ vào số lượng thực tế đem xếp kệ (số đó luôn là passedQuantity).
  creditedQuantity     Int

  @@unique([inspectionId, stageCode])
  @@map("transfer_inspection_items")
}

model TransferItem {
  id          String    @id @default(cuid())
  transferId  String
  transfer    Transfer  @relation(fields: [transferId], references: [id])
  lotId       String
  lot         Lot       @relation(fields: [lotId], references: [id])
  quantity    Int
  notes       String?
  // NV cấy mô tự khai "không đạt" trong số `quantity` đang bàn giao (VD cây thành phẩm quá nhỏ) — CHỈ áp
  // dụng cho lô thành phẩm (T01/T05), luôn 0 với lô mẫu mẹ (M05, coi như đạt hết). KHÔNG ảnh hưởng tới
  // số lượng thực tế đem xếp kệ (`quantity` giữ nguyên, không tách vật lý) — chỉ dùng để tính "số lượng
  // ghi nhận" cho lương: luồng Xanh dùng thẳng số này, luồng Đỏ cho Kho mô xác nhận/sửa lại lúc kiểm tra
  // (xem TransferInspectionItem.unqualifiedQuantity).
  unqualifiedQuantity Int @default(0)
  // Đã được xếp kệ (mẫu mẹ hoặc ra rễ) — dùng cho luồng bàn giao Phòng tối Xanh (xem
  // /transfers/receive-phong-toi), cho phép xác nhận ĐỘC LẬP từng nhóm (mẫu mẹ / ra rễ) trong cùng 1
  // phiếu thay vì phải xong cả phiếu mới CONFIRMED. null = chưa xếp.
  confirmedAt DateTime?

  @@map("transfer_items")
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id              String      @id @default(cuid())
  code            String      @unique
  saleId          String
  sale            User        @relation(fields: [saleId], references: [id])
  customerCode    String
  market          OrderMarket
  status          OrderStatus @default(DRAFT)
  holdUntil       DateTime?
  // Sale tự ước lượng lúc tạm giữ đơn — chỉ để tham khảo lên kế hoạch, không ràng buộc nghiệp vụ (khác
  // holdUntil, vốn quyết định lúc nào đơn tự hủy).
  expectedShipAt  DateTime?
  confirmedAt     DateTime?
  shippedAt       DateTime?
  cancelledAt     DateTime?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]
  processingRequests OrderProcessingRequest[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  lotId     String
  lot       Lot     @relation(fields: [lotId], references: [id])
  // Số thực sự cần cho đơn — bằng `quantity` ở dòng bình thường (null). Khác null khi dòng này là bù
  // túi từ 1 quy cách khác (VD thiếu 21 cây T01, bù từ 1 lô T05 phải mở nguyên túi 25 cây): `quantity`
  // giữ NGUYÊN CẢ TÚI (25, đã trừ khỏi tồn đạt tiêu chuẩn ngay lúc Tạm giữ — xem POST /api/orders), còn
  // `neededQuantity` (21) là phần thật sự dùng cho đơn; `quantity - neededQuantity` là phần dư, chỉ quy
  // đổi sang T01 lúc Xác nhận đơn (xem PATCH /api/orders/[id] action=confirm).
  neededQuantity Int?
  quantity  Int
  unitPrice Float?
  notes     String?

  processingRequest OrderProcessingRequest?

  @@map("order_items")
}

enum OrderProcessingRequestStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Yêu cầu tách túi phát sinh ngay khi Sale tạm giữ đơn (HELD) mà 1 OrderItem cần trừ tồn thật không
// tròn quy cách túi (VD cần 2 cây nhưng lô nguồn là T05/túi 5 cây) — chưa trừ gì cả lúc PENDING (tồn
// thực chỉ đổi khi Kho thành phẩm bấm "Hoàn thành": trừ sourceLot theo deductQuantity, cộng surplus
// vào 1 lô T01 đạt tiêu chuẩn). Trong lúc PENDING, tồn đạt tiêu chuẩn vẫn trừ neededQuantity qua HELD-netting bình
// thường; một khi COMPLETED, dòng này bị loại khỏi HELD-netting (xem getQualifiedLots) vì tồn thực đã
// giảm thật, tránh trừ đôi. CANCELLED khi đơn hết hạn/hủy trong lúc còn PENDING.
model OrderProcessingRequest {
  id              String    @id @default(cuid())
  code            String    @unique
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  orderItemId     String    @unique
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id])
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id])
  // Chỉ có giá trị khi sourceLot đang ở Kho hàn túi/Theo dõi (không phải Phòng đạt tiêu chuẩn) — Phòng
  // đạt tiêu chuẩn ĐÍCH mà số lượng dư (nếu có) sẽ được cộng vào lúc hoàn thành, vì phòng nguồn
  // (roomId ở trên) không phải phòng bán được nên không thể cộng dư ngược lại đó như tier "mở túi"
  // thường (xem PATCH /api/order-processing-requests/[id]). null = dùng luôn sourceLot.roomId như cũ
  // (tier mở túi trong Phòng đạt tiêu chuẩn, không đổi phòng).
  targetRoomId    String?
  targetRoom      Room?     @relation("OrderProcessingRequestTarget", fields: [targetRoomId], references: [id])
  plantTypeId     String
  plantType       PlantType @relation(fields: [plantTypeId], references: [id])
  sourceLotId     String
  sourceLot       Lot       @relation(fields: [sourceLotId], references: [id])
  sourceStageCode String
  neededQuantity  Int
  bagSize         Int
  // Kế hoạch lúc giữ đơn — deductQuantity đã bao gồm cả phần bù tròn túi lẫn dự phòng hao hụt 5% (nếu
  // có, chỉ áp dụng cho tier quy đổi quy cách trong Phòng đạt tiêu chuẩn — xem orders/check/route.ts),
  // surplusQuantity = deductQuantity - neededQuantity (không tách riêng field dự phòng).
  deductQuantity  Int
  surplusQuantity Int
  // Số liệu THẬT thủ kho nhập lúc "Hoàn thành" — có thể khác kế hoạch. actualSurplusQuantity trả về
  // ĐÚNG quy cách nguồn (sourceStageCode), khác surplusQuantity kế hoạch (quy về T01) — xem PATCH
  // /api/order-processing-requests/[id]. null = chưa hoàn thành.
  actualDeductQuantity  Int?
  actualOutputQuantity  Int?
  actualSurplusQuantity Int?
  status          OrderProcessingRequestStatus @default(PENDING)
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  completedById   String?
  completedBy     User?     @relation(fields: [completedById], references: [id])

  @@map("order_processing_requests")
}

// ============================================================
// PROCESSING TICKETS (Kho thành phẩm — "Xử lý cây")
// ============================================================

// Phiếu xử lý — chuyển đổi 1 lượng cây từ quy cách này sang quy cách khác trong cùng 1 Phòng đạt tiêu chuẩn
// (VD tách túi T10 thành T01 sau khi xử lý lá vàng). Tồn kho trừ/cộng NGAY khi tạo phiếu (phiếu là biên
// bản ghi việc đã xử lý xong, không có luồng "đang xử lý" chờ duyệt) — dueAt chỉ là mốc SLA để theo dõi.
model ProcessingTicket {
  id              String    @id @default(cuid())
  code            String    @unique
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id])
  plantTypeId     String
  plantType       PlantType @relation(fields: [plantTypeId], references: [id])
  inputStageCode  String
  inputQuantity   Int
  outputStageCode String
  outputQuantity  Int
  // Lô đầu ra luôn tồn tại ngay sau khi tạo phiếu — hoặc cộng dồn vào lô ACTIVE cùng loại cây + quy
  // cách đã có sẵn trong phòng, hoặc tạo lô mới nếu chưa có (xem POST /api/processing-tickets).
  outputLotId     String
  outputLot       Lot       @relation(fields: [outputLotId], references: [id])
  notes           String?
  dueAt           DateTime?
  createdById     String
  createdBy       User      @relation(fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())

  inputLots ProcessingTicketInputLot[]

  @@map("processing_tickets")
}

// Ghi lại đã trừ từ (các) lô đầu vào nào, bao nhiêu — audit trail cho việc phân bổ FIFO khi 1 phiếu
// phải trừ từ nhiều lô mới đủ số lượng đầu vào yêu cầu.
model ProcessingTicketInputLot {
  id                 String           @id @default(cuid())
  processingTicketId String
  processingTicket   ProcessingTicket @relation(fields: [processingTicketId], references: [id])
  lotId              String
  lot                Lot              @relation(fields: [lotId], references: [id])
  quantity           Int

  @@map("processing_ticket_input_lots")
}

// ============================================================
// ALERTS
// ============================================================

model Alert {
  id          String      @id @default(cuid())
  type        AlertType
  status      AlertStatus @default(UNREAD)
  title       String
  message     String
  userId      String?
  targetRole  UserRole?
  user        User?       @relation(fields: [userId], references: [id])
  relatedId   String?
  relatedType String?
  cause       DeviationCause?
  createdAt   DateTime    @default(now())
  readAt      DateTime?

  @@map("alerts")
}
